{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ipykeep extension (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/editors/vscode"],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "build ipykeep extension"
    }
  ]
}
